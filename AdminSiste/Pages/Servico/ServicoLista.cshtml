@page
@model AdminSiste.Pages.Servico.ServicoListaModel
@{
    ViewData["Title"] = "Lista de Serviços";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success">@TempData["MensagemSucesso"]</div>
}

<h2>Lista de Serviços</h2>
<a asp-page="/Servico/ServicoCadastro" class="btn btn-primary mb-3">Novo Serviço</a>

<table class="table table-striped table-bordered text-center align-middle">
    <thead class="thead-dark">
        <tr>
            <th style="width: 120px;">Código Interno</th>
            <th style="width: 250px;">Nome do Serviço</th>
            <th style="width: 120px;">Valor Venda</th>
            <th style="width: 120px;">Comissão (%)</th>
            <th style="width: 200px;">Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var servico in Model.Servicos)
    {
        <tr>
            <td>@servico.CodigoInterno</td>
            <td>@servico.Nome</td>
            <td>@servico.ValorVenda.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
            <td>@servico.Comissao.ToString("F0")</td>
            <td>
                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-sm btn-warning action-btn" asp-page="/Servico/ServicoCadastro" asp-route-id="@servico.Id">Editar</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@servico.Id" class="m-0 p-0">
                        <button type="submit" class="btn btn-sm btn-danger action-btn" onclick="return confirm('Confirma exclusão?');">Excluir</button>
                    </form>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

<style>
    .action-btn {
        min-width: 70px;
        max-width: 70px;
        text-align: center;
        box-sizing: border-box;
        padding: 2px 4px;
        font-size: 0.75rem;
        line-height: 1.2;
    }
    table th, table td {
        vertical-align: middle;
    }
</style>
