@page "/Cliente/ClienteCadastro"
@model AdminSiste.Pages.Cliente.ClienteCadastroModel
@{
    ViewData["Title"] = "Cadastro de Cliente";
}

<div class="card mt-5" style="min-width: 1200px;">
    <div class="card-header">
        <i class="fa fa-pencil-square-o"></i> Dados gerais
    </div>
    
    <div class="card-body">
        <form method="post">
            <!-- Primeira linha -->
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="ClienteTipoPessoa">Tipo de cliente</label>
                    <select id="ClienteTipoPessoa" name="Cliente.TipoPessoa" class="form-control" required>
                        <option value="">Selecione</option>
                        <option value="PF">Pessoa Física</option>
                        <option value="PJ">Pessoa Jurídica</option>
                        <option value="ES">Estrangeiro</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="ClienteSituacao">Situação</label>
                    <select id="ClienteSituacao" name="Cliente.Situacao" class="form-control">
                        <option value="1">Ativo</option>
                        <option value="0">Inativo</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="ClienteNome">Nome</label>
                    <input type="text" id="ClienteNome" name="Cliente.Nome" maxlength="100" class="form-control" required />
                </div>
                <div class="col-md-3 mb-3">
                    <label for="ClienteEmail">E-mail</label>
                    <input type="email" id="ClienteEmail" name="Cliente.Email" maxlength="60" class="form-control" />
                    <span class="text-danger" asp-validation-for="Cliente.Email"></span>
                </div>
            </div>

            <!-- Segunda linha -->
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="ClienteTelefone">Telefone comercial</label>
                    <input type="text" id="ClienteTelefone" name="Cliente.Telefone" maxlength="50" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label for="ClienteCelular">Telefone celular</label>
                    <input type="text" id="ClienteCelular" name="Cliente.Celular" maxlength="50" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label for="ClienteFax">FAX</label>
                    <input type="text" id="ClienteFax" name="Cliente.Fax" maxlength="50" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label for="ClienteSite">Site</label>
                    <input type="text" id="ClienteSite" name="Cliente.Site" maxlength="100" class="form-control" />
                </div>
            </div>

            <!-- Terceira linha -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ClienteVendedor">Vendedor / Responsável</label>
                    <input type="text" id="ClienteVendedor" name="Cliente.Vendedor" class="form-control" placeholder="Digite para buscar" autocomplete="off" />
                </div>
            </div>

            <!-- Botão -->
            <div class="row mt-3">
                <div class="col-md-12 text-right">
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </div>
        </form>
        <!-- Endereços -->
        <div class="mt-3">
            <div class="card">
                <div class="card-header">
                    <h5 class="m-0"><i class="glyphicon glyphicon-map-marker"></i> Endereço</h5>
                </div>
                <div class="card-body">
                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <!-- Espaçadores/Ações futuros -->
                        </div>
                        <!-- Primeira linha -->
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoTipo">Tipo</label>
                                <input type="text" class="form-control" id="EnderecoTipo" name="Endereco.Tipo" placeholder="Tipo" autocomplete="off" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoCEP">CEP</label>
                                <input type="text" class="form-control" id="EnderecoCEP" name="Endereco.CEP" maxlength="10" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoLogradouro">Logradouro</label>
                                <input type="text" class="form-control" id="EnderecoLogradouro" name="Endereco.Logradouro" maxlength="150" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoNumero">Número</label>
                                <input type="text" class="form-control" id="EnderecoNumero" name="Endereco.Numero" maxlength="10" />
                            </div>
                        </div>
                        <!-- Segunda linha -->
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoComplemento">Complemento</label>
                                <input type="text" class="form-control" id="EnderecoComplemento" name="Endereco.Complemento" maxlength="100" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoBairro">Bairro</label>
                                <input type="text" class="form-control" id="EnderecoBairro" name="Endereco.Bairro" maxlength="100" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoCidade">Cidade</label>
                                <input type="text" class="form-control" id="EnderecoCidade" name="Endereco.Cidade" maxlength="100" autocomplete="off" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="EnderecoUF">UF</label>
                                <input type="text" class="form-control" id="EnderecoUF" name="Endereco.UF" maxlength="2" />
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-12 text-right">
                                <button id="AdicionarEndereco" type="button" class="btn btn-primary">
                                    <i class="fa fa-plus-circle"></i> Adicionar Endereço
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contatos -->
        <div class="mt-3">
            <div class="card">
                <div class="card-header">
                    <h5 class="m-0"><i class="glyphicon glyphicon-earphone"></i> Contato</h5>
                </div>
                <div class="card-body">
                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <!-- Espaçadores/Ações futuros -->
                        </div>
                        <!-- Primeira linha -->
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="ContatoTelefoneComercial">Telefone Comercial</label>
                                <input type="text" class="form-control" id="ContatoTelefoneComercial" name="Contato.TelefoneComercial" maxlength="50" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="ContatoTelefoneCelular">Telefone Celular</label>
                                <input type="text" class="form-control" id="ContatoTelefoneCelular" name="Contato.TelefoneCelular" maxlength="50" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="ContatoFax">Fax</label>
                                <input type="text" class="form-control" id="ContatoFax" name="Contato.Fax" maxlength="50" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="ContatoEmail">E-mail</label>
                                <input type="email" class="form-control" id="ContatoEmail" name="Contato.Email" maxlength="60" />
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-12 text-right">
                                <button id="AdicionarContato" type="button" class="btn btn-primary">
                                    <i class="fa fa-plus-circle"></i> Adicionar Contato
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
