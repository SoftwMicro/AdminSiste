@page
@model AdminSiste.Pages.Cliente.ListaClientesModel
@{
    ViewData["Title"] = "Lista de Clientes";
}

<h2>Lista de Clientes</h2>

<a class="btn btn-primary mb-3" asp-page="/Cliente/ClienteCadastro">Novo Cliente</a>

<table class="table table-striped table-bordered text-center align-middle">
    <thead class="thead-dark">
        <tr>
            <th style="width: 120px;">Tipo</th>
            <th style="width: 120px;">Situação</th>
            <th style="width: 250px;">Nome</th>
            <th style="width: 250px;">E-mail</th>
            <th style="width: 200px;">Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var cliente in Model.Clientes)
    {
        <tr>
            <td>@cliente.Tipo</td>
            <td>@(cliente.Ativo ? "Ativo" : "Inativo")</td>
            <td>@cliente.Nome</td>
            <td>@cliente.Email</td>
            <td>
                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-sm btn-warning action-btn" asp-page="/Cliente/ClienteCadastro" asp-route-id="@cliente.Id">Editar</a>
                    <form method="post" asp-page-handler="Excluir" asp-route-id="@cliente.Id" class="m-0 p-0">
                        <button type="submit" class="btn btn-sm btn-danger action-btn" onclick="return confirm('Confirma exclusão?');">Excluir</button>
                    </form>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

<style>
    /* Padroniza largura e altura dos botões */
    .action-btn {
        min-width: 70px;
        max-width: 70px;
        text-align: center;
        box-sizing: border-box;
        padding: 2px 4px;   /* reduz altura */
        font-size: 0.75rem; /* texto menor */
        line-height: 1.2;   /* altura da linha menor */
    }
    table th, table td {
        vertical-align: middle;
    }
</style>
