@page "/Produto/ProdutoCadastro"
@model AdminSiste.Pages.Produto.ProdutoCadastroModel
@{
    ViewData["Title"] = "Cadastro de Produto";
}

@if (!string.IsNullOrEmpty(Model.MensagemSucesso))
{
    <div class="modal fade show" id="modalSucesso" tabindex="-1" style="display:block; background:rgba(0,0,0,0.5);"
         aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Sucesso</h5>
                </div>
                <div class="modal-body">
                    <p>@Model.MensagemSucesso</p>
                </div>
                <div class="modal-footer">
                    <a href="/Produto/ProdutoLista" class="btn btn-success">OK</a>
                </div>
            </div>
        </div>
    </div>
}

<div class="card mt-5" style="min-width: 1200px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    <div class="card-header">
        <i class="fa fa-cube"></i> Dados do Produto
    </div>
    <div class="card-body">
        <form method="post" id="formProduto">
            <input type="hidden" asp-for="Produto.Id" />
            <!-- Seção 1: Informações Gerais -->
            <h5>Informações Gerais</h5>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Produto.Nome">Nome</label>
                    <input asp-for="Produto.Nome" class="form-control" required />
                    <span asp-validation-for="Produto.Nome" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Codigo">Código Interno</label>
                    <div class="input-group">
                        <input asp-for="Produto.Codigo" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary">Gerar</button>
                    </div>
                    <span asp-validation-for="Produto.Codigo" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.CodigoBarra">Código de Barra</label>
                    <input asp-for="Produto.CodigoBarra" class="form-control" />
                    <span asp-validation-for="Produto.CodigoBarra" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.GrupoProdutoId">Grupo do Produto</label>
                    <input asp-for="Produto.GrupoProdutoId" class="form-control" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.MovimentaEstoque">Movimenta Estoque?</label>
                    <select asp-for="Produto.MovimentaEstoque" class="form-control">
                        <option value="true">Sim</option>
                        <option value="false">Não</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.PossuiNotaFiscal">Habilitar Nota Fiscal?</label>
                    <select asp-for="Produto.PossuiNotaFiscal" class="form-control">
                        <option value="true">Sim</option>
                        <option value="false">Não</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.PossuiVariacao">Possui Variações?</label>
                    <select asp-for="Produto.PossuiVariacao" class="form-control">
                        <option value="true">Sim</option>
                        <option value="false">Não</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.PossuiComposicao">Possui Composição?</label>
                    <select asp-for="Produto.PossuiComposicao" class="form-control">
                        <option value="true">Sim</option>
                        <option value="false">Não</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.UnidadeEntradaId">Unidade de Entrada</label>
                    <input asp-for="Produto.UnidadeEntradaId" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.QuantidadeSaida">Quantidade de Saída</label>
                    <input asp-for="Produto.QuantidadeSaida" class="form-control" type="number" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.UnidadeSaidaId">Unidade de Saída</label>
                    <input asp-for="Produto.UnidadeSaidaId" class="form-control" />
                </div>
            </div>
            <hr />
            <!-- Seção 2: Detalhes e Dimensões -->
            <h5>Detalhes e Dimensões</h5>
            <div class="row">
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.Detalhes.Peso">Peso (kg)</label>
                    <input asp-for="Produto.Detalhes.Peso" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.Detalhes.Largura">Largura (m)</label>
                    <input asp-for="Produto.Detalhes.Largura" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.Detalhes.Altura">Altura (m)</label>
                    <input asp-for="Produto.Detalhes.Altura" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.Detalhes.Comprimento">Comprimento (m)</label>
                    <input asp-for="Produto.Detalhes.Comprimento" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Produto.Detalhes.Comissao">Comissão (%)</label>
                    <input asp-for="Produto.Detalhes.Comissao" class="form-control" type="number" step="0.01" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 mb-3">
                    <div class="form-check">
                        <input asp-for="Produto.Detalhes.Ativo" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="Produto.Detalhes.Ativo">Produto Ativo</label>
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <div class="form-check">
                        <input asp-for="Produto.Detalhes.VendidoSeparadamente" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="Produto.Detalhes.VendidoSeparadamente">Vendido Separadamente</label>
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <div class="form-check">
                        <input asp-for="Produto.Detalhes.ComercializavelPDV" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="Produto.Detalhes.ComercializavelPDV">Comercializável no PDV</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Produto.Detalhes.Descricao">Descrição/Detalhes</label>
                    <textarea asp-for="Produto.Detalhes.Descricao" class="form-control"></textarea>
                </div>
            </div>
            <hr />
            <!-- Seção 3: Custos e Precificação -->
            <h5>Custos e Precificação</h5>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Preco.ValorCustoMedio">Valor de Custo</label>
                    <input asp-for="Produto.Preco.ValorCustoMedio" class="form-control moeda" type="text" value="@(Model.Produto?.Preco?.ValorCustoMedio.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Preco.ValorDespesasAcessorias">Despesas Acessórias</label>
                    <input asp-for="Produto.Preco.ValorDespesasAcessorias" class="form-control moeda" type="text" value="@(Model.Produto?.Preco?.ValorDespesasAcessorias.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Preco.ValorOutrasDespesas">Outras Despesas</label>
                    <input asp-for="Produto.Preco.ValorOutrasDespesas" class="form-control moeda" type="text" value="@(Model.Produto?.Preco?.ValorOutrasDespesas.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Preco.ValorCusto">Custo Final</label>
                    <input asp-for="Produto.Preco.ValorCusto" class="form-control moeda" type="text" value="@(Model.Produto?.Preco?.ValorCusto.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <button type="button" class="btn btn-info" id="btnCalcularVenda">Calcular Valor de Venda</button>
                </div>
            </div>
            <hr />
            <!-- Seção 4: Estoque -->
            <h5>Estoque</h5>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Estoque.EstoqueMinimo">Estoque Mínimo</label>
                    <input asp-for="Produto.Estoque.EstoqueMinimo" class="form-control" type="number" step="0.01" value="@(Model.Produto?.Estoque?.EstoqueMinimo.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Estoque.EstoqueMaximo">Estoque Máximo</label>
                    <input asp-for="Produto.Estoque.EstoqueMaximo" class="form-control" type="number" step="0.01" value="@(Model.Produto?.Estoque?.EstoqueMaximo.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Produto.Estoque.QuantidadeAtual">Quantidade Atual</label>
                    <input asp-for="Produto.Estoque.QuantidadeAtual" class="form-control" type="number" step="0.01" value="@(Model.Produto?.Estoque?.QuantidadeAtual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-12 text-right">
                    <button type="submit" class="btn btn-success" id="btnSalvar">Salvar</button>
                </div>
            </div>
        </form>
        <script>
            // Máscara para moeda brasileira
            document.querySelectorAll('.moeda').forEach(function (el) {
                el.addEventListener('input', function (e) {
                    let v = e.target.value.replace(/\D/g, "");
                    v = (v/100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                    e.target.value = v;
                });
                // Ao carregar, formata valor inicial se houver
                if (el.value) {
                    let v = el.value.replace(/\D/g, "");
                    if (v) el.value = (v/100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                }
            });

            // Remove máscara antes de enviar
            document.getElementById('formProduto').addEventListener('submit', function (e) {
                document.querySelectorAll('.moeda').forEach(function (el) {
                    el.value = el.value.replace(/[^\d,]/g, '').replace(',', '.');
                });
                var btn = document.getElementById('btnSalvar');
                btn.disabled = true;
                btn.innerText = 'Salvando...';
            });
        </script>
    </div>
</div>
<a asp-page="ProdutoLista" class="btn btn-secondary mb-2">Voltar para Lista</a>
